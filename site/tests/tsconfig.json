{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vitest/browser"],
    // Keep browser matchers on the same Vitest instance as the tests.
    "paths": {
      "vitest": ["../node_modules/vitest"]
    },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["seo.test.ts"]
}
