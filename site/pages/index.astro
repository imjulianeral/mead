---
import PageLayout from "blume/components/layout/PageLayout.astro";
import Icon from "blume/components/Icon.astro";
import data from "blume:data";

const { config } = data;

// The site is served under a base path on GitHub Pages (/mead), and Blume only rewrites
// links in Markdown content, so every link on this page goes through `to`.
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const to = (route: string) => `${basePath}${route}`;

const installCommand = `curl -fsSL ${data.navigation.repoUrl}/releases/latest/download/install.sh | sh`;

const title = "mead: a Git-native package manager for Odin";
// A hand-made share card for the home page, in place of the generated one (see scripts/og-home.html).
const ogImage = config.site ? new URL(to("/social/home.png"), config.site).href : null;

const rows = [
  [
    { name: "init", href: to("/cli/init"), blurb: "Start a meade.kdl" },
    { name: "versions", href: to("/cli/versions"), blurb: "Browse an origin" },
    { name: "add", href: to("/cli/add"), blurb: "Record a selection" },
  ],
  [
    { name: "install", href: to("/cli/install"), blurb: "Lock & fetch to deps/" },
    { name: "update", href: to("/cli/update"), blurb: "Re-resolve selections" },
    { name: "build", href: to("/cli/build"), blurb: "Compile with bare imports" },
    { name: "run", href: to("/cli/run"), blurb: "Build, then execute" },
  ],
  [
    { name: "exec", href: to("/cli/exec"), blurb: "Run a project tool" },
    { name: "tree", href: to("/cli/tree"), blurb: "Origins & revisions" },
    { name: "env", href: to("/cli/env"), blurb: "Bindings & paths" },
  ],
];

const pipeline = [
  {
    file: "meade.kdl",
    title: "Declare",
    text: "Name each dependency and choose a tag, branch, commit, or GitHub release.",
    href: to("/manifest"),
  },
  {
    file: "mead.lock",
    title: "Lock",
    text: "mead resolves every selection to an exact commit and records it as JSON.",
    href: to("/reference/lockfile"),
  },
  {
    file: "deps/",
    title: "Install",
    text: "The full tree of each locked commit, staged and swapped in atomically.",
    href: to("/cli/install"),
  },
  {
    file: ".mead/build/",
    title: "Build",
    text: "A generated copy rewrites bare imports so the stock Odin compiler resolves them.",
    href: to("/guide/bare-imports"),
  },
];
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{ title, description: config.description }}
  ogImage={ogImage}
  ogImageAlt="mead, a Git-native package manager for Odin: a terminal adding, installing, and running a dependency"
  ogImageSize={{ width: 1200, height: 630 }}
>
  <div class="home">
    <!-- Hero -->
    <section class="hero">
      <svg class="comb-bg" aria-hidden="true">
        <defs>
          <pattern id="comb" width="56" height="97" patternUnits="userSpaceOnUse" patternTransform="scale(0.9)">
            <path
              d="M28 0 56 16.2v32.3L28 64.7 0 48.5V16.2Z M28 64.7v32.3 M0 97V80.8 M56 97V80.8"
              fill="none"
              stroke="currentColor"
              stroke-width="1"></path>
          </pattern>
          <radialGradient id="combfade" cx="70%" cy="35%" r="65%">
            <stop offset="0%" stop-color="white" stop-opacity="1"></stop>
            <stop offset="100%" stop-color="white" stop-opacity="0"></stop>
          </radialGradient>
          <mask id="combmask"><rect width="100%" height="100%" fill="url(#combfade)"></rect></mask>
        </defs>
        <rect width="100%" height="100%" fill="url(#comb)" mask="url(#combmask)"></rect>
      </svg>

      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow"><span class="dot"></span> v0.1.0 · a package manager for Odin</p>
          <h1>Packages, poured <em>straight&nbsp;from the&nbsp;source.</em></h1>
          <p class="lede">
            mead installs Odin dependencies directly from their authors' Git repositories. You don't need a
            registry, a repackaging service, or an account. You choose a revision, and mead locks its exact
            commit.
          </p>
          <div class="ctas">
            <a class="btn primary" href={to("/guide/quickstart")}>Get started →</a>
            <a class="btn ghost" href={to("/cli")}>CLI reference</a>
          </div>
        </div>

        <div class="install">
          <span class="install-label">install</span>
          <div class="install-command">
            <code>{installCommand}</code>
            <button class="copy-install" type="button" aria-label="Copy install command">
              <Icon name="copy" size={14} />
              <span>Copy</span>
            </button>
          </div>
        </div>

        <div class="terminal" role="img" aria-label="A terminal session adding, installing, and running an Odin project with mead">
          <div class="term-bar">
            <span></span><span></span><span></span>
            <p>~/orchard</p>
          </div>
          <pre class="term-body"><span class="l l1"><b>$</b> mead add https://github.com/example-author/geometry.git \</span>
<span class="l l1">    --as example_pkg --release v1.2.3 --path src/geometry</span>
<span class="l l2 dim">example_pkg release "v1.2.3" resolves to 6e93eafa715d</span>
<span class="l l2 dim">added dependency "example_pkg" to meade.kdl; run `mead install`</span>
<span class="l l3"><b>$</b> mead install</span>
<span class="l l4 dim">resolved example_pkg: release v1.2.3 -&gt; 6e93eafa715d</span>
<span class="l l4 dim">fetching https://github.com/example-author/geometry.git 6e93eafa715d</span>
<span class="l l4 ok">installed 1 dependency and 0 tools</span>
<span class="l l5"><b>$</b> mead run app -- --some-flag</span>
<span class="l l6 dim">building app</span>
<span class="l l6 dim">built ~/orchard/.mead/bin/app</span>
<span class="l l6 honey">length: 25</span>
<span class="l l7"><b>$</b> <i class="cursor"></i></span></pre>
        </div>
      </div>
    </section>

    <!-- Principles -->
    <section class="principles">
      <div class="principle">
        <span class="num">01</span>
        <h3>No registry</h3>
        <p>An origin is any HTTPS, SSH, or <code>file://</code> Git URL. Authors publish by pushing a tag.</p>
      </div>
      <div class="principle">
        <span class="num">02</span>
        <h3>Exact commits</h3>
        <p>
          <code>mead.lock</code> keeps the full commit ID for every selection. If a branch or tag moves later,
          your build doesn't change.
        </p>
      </div>
      <div class="principle">
        <span class="num">03</span>
        <h3>Stock compiler</h3>
        <p>
          You write <code>import "geometry"</code>, and mead turns that bare name into a path in a generated
          build copy that the stock Odin compiler can build.
        </p>
      </div>
    </section>

    <!-- Pipeline -->
    <section class="pipeline-wrap">
      <header class="section-head">
        <p class="kicker">How it flows</p>
        <h2>From manifest to binary</h2>
      </header>
      <ol class="pipeline">
        {
          pipeline.map((step, i) => (
            <li>
              <a href={step.href}>
                <span class="hex-badge">{i + 1}</span>
                <code class="file">{step.file}</code>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Command honeycomb -->
    <section class="hive-wrap">
      <header class="section-head">
        <p class="kicker">The whole CLI</p>
        <h2>Ten commands, one comb</h2>
        <p class="sub">Each cell opens the full reference for that command: arguments, output, and errors.</p>
      </header>
      <div class="hive">
        {
          rows.map((row) => (
            <div class="hive-row">
              {row.map((c) => (
                <a class="cell" href={c.href}>
                  <span class="cell-inner">
                    <code>{c.name}</code>
                    <small>{c.blurb}</small>
                  </span>
                </a>
              ))}
            </div>
          ))
        }
      </div>
    </section>

    <!-- Manifest teaser -->
    <section class="teaser">
      <div class="teaser-copy">
        <p class="kicker">meade.kdl</p>
        <h2>A manifest you can read aloud</h2>
        <p>
          Manifests use KDL v2. Every dependency has a name, an origin, and exactly one revision selector. When{" "}<code>mead add</code> edits the file, it inserts new text and leaves your comments and formatting
          unchanged.
        </p>
        <a class="btn ghost" href={to("/manifest")}>Manifest reference →</a>
      </div>
      <pre class="kdl"><span class="c">// orchard/meade.kdl</span>
<span class="k">schema</span> <span class="n">1</span>

<span class="k">package</span> <span class="s">"orchard"</span> <span class="p">version</span>=<span class="s">"0.1.0"</span>

<span class="k">dependencies</span> {'{'}
    <span class="k">dependency</span> <span class="s">"example_pkg"</span> \
        <span class="p">git</span>=<span class="s">"https://github.com/…/geometry.git"</span> \
        <span class="p">release</span>=<span class="s">"v1.2.3"</span>
    <span class="k">dependency</span> <span class="s">"renderer"</span> \
        <span class="p">git</span>=<span class="s">"https://github.com/…/renderer.git"</span> \
        <span class="p">branch</span>=<span class="s">"development"</span>
{'}'}

<span class="k">tools</span> {'{'}
    <span class="k">tool</span> <span class="s">"assetgen"</span> \
        <span class="p">git</span>=<span class="s">"https://github.com/…/assetgen.git"</span> \
        <span class="p">tag</span>=<span class="s">"v0.4.0"</span>
{'}'}

<span class="k">targets</span> {'{'}
    <span class="k">target</span> <span class="s">"app"</span> <span class="p">kind</span>=<span class="s">"executable"</span> <span class="p">path</span>=<span class="s">"src"</span> {'{'}
        <span class="k">flags</span> <span class="s">"-o:speed"</span>
    {'}'}
{'}'}</pre>
    </section>
  </div>
</PageLayout>

<script>
  import { copyText, flashLabel } from "blume/components/copy-feedback.ts";

  document.addEventListener("click", async (event) => {
    const button = event.target instanceof Element ? event.target.closest(".copy-install") : null;
    const command = button?.parentElement?.querySelector("code")?.textContent;
    const label = button?.querySelector("span");
    if (!command || !label) return;

    flashLabel(label, await copyText(command) ? "Copied" : "Copy failed");
  });
</script>

<style>
  .home {
    --hex-w: 168px;
    --hex-h: calc(var(--hex-w) * 1.1547);
    --gap: 10px;
    color: var(--blume-foreground);
    overflow-x: clip;
  }

  .home code {
    font-family: var(--blume-font-mono);
    font-size: 0.88em;
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding: clamp(3rem, 8vw, 6.5rem) 1rem clamp(3rem, 6vw, 5rem);
    isolation: isolate;
  }
  .comb-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--mead-comb);
    z-index: -1;
  }
  .hero::after {
    content: "";
    position: absolute;
    right: 8%;
    top: 12%;
    width: min(520px, 70vw);
    aspect-ratio: 1;
    background: radial-gradient(circle, var(--mead-glow), transparent 65%);
    filter: blur(20px);
    z-index: -1;
    pointer-events: none;
  }
  .hero-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    column-gap: clamp(2rem, 5vw, 4rem);
    row-gap: 1.75rem;
    align-items: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--blume-border);
    border-radius: 999px;
    background: color-mix(in oklab, var(--blume-background) 80%, transparent);
    color: var(--blume-muted-foreground);
    margin: 0 0 1.4rem;
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--mead-honey);
    box-shadow: 0 0 0 4px var(--mead-glow);
  }
  .hero h1 {
    font-family: var(--blume-font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 6vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0 0 1.25rem;
  }
  .hero h1 em {
    font-style: italic;
    font-weight: 400;
    background: linear-gradient(100deg, var(--mead-honey-deep), var(--mead-honey) 60%, var(--mead-honey-deep));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede {
    font-size: 1.12rem;
    line-height: 1.65;
    color: var(--blume-muted-foreground);
    max-width: 36rem;
    margin: 0 0 2rem;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.72rem 1.25rem;
    border-radius: calc(var(--blume-radius) + 2px);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }
  .btn.primary {
    background: var(--blume-accent);
    color: var(--blume-accent-foreground, #fff);
    box-shadow: 0 6px 24px -8px var(--blume-accent);
  }
  .btn.primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 30px -8px var(--blume-accent);
  }
  .btn.ghost {
    border: 1px solid var(--blume-border);
    color: var(--blume-foreground);
    background: color-mix(in oklab, var(--blume-background) 70%, transparent);
  }
  .btn.ghost:hover {
    border-color: var(--blume-accent);
  }
  .install {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    max-width: 100%;
    font-size: 0.85rem;
  }
  .install-label {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--blume-muted-foreground);
  }
  .install-command {
    display: flex;
    max-width: 100%;
    border-radius: 6px;
    border: 1px dashed var(--blume-border);
    background: var(--blume-code-background);
  }
  .install code {
    display: block;
    min-width: 0;
    white-space: pre;
    overflow-x: auto;
    padding: 0.4rem 0.7rem;
    line-height: 1.6;
  }
  .copy-install {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    flex-shrink: 0;
    min-width: 6rem;
    padding: 0.4rem 0.65rem;
    border: 0;
    border-inline-start: 1px solid var(--blume-border);
    border-radius: 0 5px 5px 0;
    background: transparent;
    color: var(--blume-muted-foreground);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .copy-install:hover {
    background: var(--blume-muted);
    color: var(--blume-foreground);
  }
  .copy-install:active {
    background: var(--blume-border);
  }
  .copy-install:focus-visible {
    outline: 2px solid var(--blume-accent);
    outline-offset: 2px;
  }

  /* ---------- Terminal ---------- */
  .terminal {
    grid-column: 2;
    grid-row: 1;
    border-radius: 14px;
    overflow: hidden;
    background: oklch(0.18 0.015 60);
    color: oklch(0.92 0.02 85);
    border: 1px solid oklch(0.32 0.03 60);
    box-shadow:
      0 30px 80px -30px oklch(0.3 0.08 60 / 0.6),
      0 0 0 6px color-mix(in oklab, var(--mead-honey) 12%, transparent);
    transform: rotate(-0.6deg);
    min-width: 0;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 0.9rem;
    background: oklch(0.22 0.018 60);
    border-bottom: 1px solid oklch(0.3 0.025 60);
  }
  .term-bar span {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: oklch(0.4 0.03 60);
  }
  .term-bar span:first-child {
    background: oklch(0.78 0.16 75);
  }
  .term-bar p {
    margin: 0 0 0 auto;
    font-family: var(--blume-font-mono);
    font-size: 0.72rem;
    opacity: 0.55;
  }
  .term-body {
    margin: 0;
    padding: 1.1rem 1.2rem 1.3rem;
    font-family: var(--blume-font-mono);
    font-size: 0.78rem;
    line-height: 1.75;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    background: none;
    border: 0;
  }
  .term-body b {
    color: oklch(0.8 0.15 78);
    font-weight: 700;
  }
  .term-body .dim {
    color: oklch(0.7 0.025 75);
  }
  .term-body .ok {
    color: oklch(0.82 0.13 140);
  }
  .term-body .honey {
    color: oklch(0.85 0.14 80);
    font-weight: 600;
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    vertical-align: -0.15em;
    background: oklch(0.8 0.15 78);
    animation: blink 1s steps(1) infinite;
  }
  .l {
    opacity: 0;
    animation: appear 0.35s ease forwards;
  }
  .l1 { animation-delay: 0.2s; }
  .l2 { animation-delay: 1.1s; }
  .l3 { animation-delay: 1.9s; }
  .l4 { animation-delay: 2.7s; }
  .l5 { animation-delay: 3.6s; }
  .l6 { animation-delay: 4.4s; }
  .l7 { animation-delay: 5.1s; }

  @keyframes appear {
    from { opacity: 0; transform: translateY(3px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .l { animation: none; opacity: 1; }
    .cursor { animation: none; }
  }

  /* ---------- Sections ---------- */
  .section-head {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 2.5rem;
  }
  .kicker {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--blume-accent);
  }
  .section-head h2,
  .teaser h2 {
    font-family: var(--blume-font-display);
    font-weight: 600;
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0;
  }
  .sub {
    margin: 0.8rem 0 0;
    color: var(--blume-muted-foreground);
  }

  /* ---------- Principles ---------- */
  .principles {
    width: min(72rem, calc(100% - 2rem));
    margin: 0 auto 5rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--blume-border);
    border-block: 1px solid var(--blume-border);
  }
  .principle {
    background: var(--blume-background);
    padding: 1.75rem 1.5rem;
  }
  .num {
    font-family: var(--blume-font-display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--blume-accent);
  }
  .principle h3 {
    font-family: var(--blume-font-display);
    font-size: 1.45rem;
    font-weight: 600;
    margin: 0.35rem 0 0.5rem;
    letter-spacing: -0.02em;
  }
  .principle p {
    margin: 0;
    color: var(--blume-muted-foreground);
    line-height: 1.6;
  }

  /* ---------- Pipeline ---------- */
  .pipeline-wrap {
    max-width: 72rem;
    margin: 0 auto 6rem;
    padding: 0 1rem;
  }
  .pipeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    counter-reset: step;
    position: relative;
  }
  .pipeline::before {
    content: "";
    position: absolute;
    top: 2.1rem;
    left: 6%;
    right: 6%;
    border-top: 2px dashed color-mix(in oklab, var(--blume-accent) 45%, transparent);
    z-index: 0;
  }
  .pipeline li {
    position: relative;
    z-index: 1;
  }
  .pipeline a {
    display: block;
    height: 100%;
    padding: 0 1.1rem 1.4rem;
    border-radius: var(--blume-radius);
    text-decoration: none;
    color: inherit;
    transition: background 0.2s ease;
  }
  .pipeline a:hover {
    background: var(--blume-muted);
  }
  .hex-badge {
    display: grid;
    place-items: center;
    width: 3.6rem;
    height: 4.15rem;
    margin: 0.2rem 0 1rem;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: var(--blume-accent);
    color: var(--blume-accent-foreground, #fff);
    font-family: var(--blume-font-display);
    font-weight: 700;
    font-size: 1.35rem;
  }
  .pipeline .file {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 5px;
    background: var(--blume-code-background);
    border: 1px solid var(--blume-border);
    font-size: 0.8rem;
  }
  .pipeline h3 {
    font-family: var(--blume-font-display);
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0.65rem 0 0.4rem;
  }
  .pipeline p {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.55;
    color: var(--blume-muted-foreground);
  }

  /* ---------- Hive ---------- */
  .hive-wrap {
    padding: 5rem 1rem 6rem;
    background:
